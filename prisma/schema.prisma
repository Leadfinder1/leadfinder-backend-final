
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  fullName String?
  role String @default("USER")
  plan String @default("FREE")
  searchesCount Int @default(0)
  aiCreditsUsed Int @default(0)
  referralCode String? @unique
  referredBy String?
  stripeCustomerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  searches Search[]
  leads Lead[]
  automations Automation[]
  outreachLogs OutreachLog[]
}

model Search {
  id String @id @default(cuid())
  userId String
  name String
  niche String
  city String
  status String @default("COMPLETED")
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  leads Lead[]
}

model Lead {
  id String @id @default(cuid())
  userId String
  searchId String?
  businessName String
  phone String?
  address String?
  rating Float?
  reviews Int?
  website String?
  mapsUrl String?
  niche String?
  city String?
  placeId String?
  email String?
  instagram String?
  facebook String?
  linkedin String?
  tiktok String?
  youtube String?
  whatsapp String?
  aiScore Int @default(0)
  opportunityLevel String @default("cold")
  scoreExplanation String?
  contactQuality Int @default(0)
  enrichmentVerified Boolean @default(false)
  auditScore Int?
  auditSummary String?
  crmStatus String @default("new")
  tags String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  search Search? @relation(fields:[searchId], references:[id], onDelete:SetNull)
  outreachLogs OutreachLog[]
}

model Automation {
  id String @id @default(cuid())
  userId String
  name String
  niche String
  city String
  frequency String @default("daily")
  enabled Boolean @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}

model OutreachLog {
  id String @id @default(cuid())
  userId String
  leadId String
  channel String
  message String
  status String @default("generated")
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  lead Lead @relation(fields:[leadId], references:[id], onDelete:Cascade)
}
